PUBLIC_ORIGIN=https://teams-assistant.example.com
IQKB_SECRETS_DIR=../IQ-kbteams-secrets
APP_MEM_LIMIT=1536m
APP_CPUS=2.0
APP_PIDS_LIMIT=128
GATEWAY_MEM_LIMIT=512m
GATEWAY_CPUS=1.0
GATEWAY_PIDS_LIMIT=64
CADDY_MEM_LIMIT=256m
CADDY_CPUS=1.0
CADDY_PIDS_LIMIT=64
MODEL_MONTHLY_ATTEMPT_LIMIT=10000
AUDIT_RETENTION_DAYS=30
TENANT_ID=
ADMIN_OBJECT_ID=
APP_CLIENT_ID=
BOT_CLIENT_ID=
TEAMS_APP_ID=
APP_ID_URI=
OAUTH_CONNECTION_NAME=iqkbteams
# Local development only: set these values in an ignored .env and load it into
# the process environment. Compose ignores these values and mounts secret files.
BOOTSTRAP_SECRET=
MODEL_API_KEY=
APP_ENCRYPTION_KEY=
MSAL_CACHE_KEY_HEX=
BRIDGE_HMAC_KEY=
APP_CLIENT_SECRET=
BOT_CLIENT_SECRET=
BRIDGE_SOCKET=/run/iqkb/bridge.sock
PARSER_SOCKET=/run/iqkb/parser.sock
SQLITE_PATH=/var/lib/iqkb/config.sqlite
# Optional source: leave the postgres_dsn secret empty to disable PostgreSQL.
