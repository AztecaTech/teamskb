# Paste into Dokploy > Environment; fill every empty required value.
PUBLIC_ORIGIN=https://teams-assistant.example.com
TENANT_ID=
ADMIN_OBJECT_ID=
APP_CLIENT_ID=
BOT_CLIENT_ID=
TEAMS_APP_ID=
APP_CLIENT_SECRET=
BOT_CLIENT_SECRET=
# Set false to test the Teams tab without Azure Bot; keep the API client secret.
BOT_ENABLED=false
OAUTH_CONNECTION_NAME=iqkbteams
BOOTSTRAP_SECRET=
MODEL_API_KEY=
# Three distinct, random 32-byte keys, each encoded as 64 hexadecimal characters.
# Keep these stable across redeployments. Store a protected backup outside volumes.
APP_ENCRYPTION_KEY=
BRIDGE_HMAC_KEY=
MSAL_CACHE_KEY_HEX=
# Optional connection TEMPLATE: no shared DB user/password; verify-full is required.
POSTGRES_DSN=
# Example: postgres://db.example.com:5432/company?sslmode=verify-full
MODEL_MONTHLY_ATTEMPT_LIMIT=10000
AUDIT_RETENTION_DAYS=30
IQKB_MEM_LIMIT=2560m
IQKB_CPUS=3.0
