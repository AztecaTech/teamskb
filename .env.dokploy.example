# Paste into Dokploy > Environment; fill every empty required value.
PUBLIC_ORIGIN=https://teams-assistant.example.com
TENANT_ID=
ADMIN_OBJECT_ID=
APP_CLIENT_ID=
BOT_CLIENT_ID=
TEAMS_APP_ID=
APP_CLIENT_SECRET=
BOT_CLIENT_SECRET=
# Set false to test the Teams tab without Azure Bot; keep the API client secret.
BOT_ENABLED=false
OAUTH_CONNECTION_NAME=iqkbteams
BOOTSTRAP_SECRET=
MODEL_API_KEY=
# Three distinct, random 32-byte keys, each encoded as 64 hexadecimal characters.
# Keep these stable across redeployments. Store a protected backup outside volumes.
APP_ENCRYPTION_KEY=
BRIDGE_HMAC_KEY=
MSAL_CACHE_KEY_HEX=
# Optional shared service connection for automatic Teams-to-database matching.
# Configure the authorization adapter in Workspace settings after redeployment.
# Use a dedicated non-superuser, NOINHERIT login without BYPASSRLS.
# Without service credentials, the legacy per-user database-login mode remains.
POSTGRES_DSN=
# Use verify_full for TLS. For a DB on the same private Docker network, set
# private_network and use its internal hostname with sslmode=disable in the URI.
POSTGRES_CONNECTION_MODE=verify_full
# Example: postgres://iqkb_service:URL_ENCODED_PASSWORD@db.example.com:5432/company?sslmode=verify-full
MODEL_MONTHLY_ATTEMPT_LIMIT=10000
AUDIT_RETENTION_DAYS=30
IQKB_MEM_LIMIT=2560m
IQKB_CPUS=3.0
